# Copy to .env and fill in. Never commit .env.
PORT=4000

# MongoDB Atlas → Database → Connect → Drivers. Put the database name (aanchol) before the "?".
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/aanchol?retryWrites=true&w=majority

# Sites allowed to call the API, comma-separated.
CLIENT_ORIGIN=http://localhost:5173
