# Copy to .env and fill in. Never commit .env.
PORT=4000

# MongoDB Atlas → Database → Connect → Drivers. Put the database name (aanchol) before the "?".
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/aanchol?retryWrites=true&w=majority

# Sites allowed to call the API, comma-separated.
CLIENT_ORIGIN=http://localhost:5173

# Signs admin logins. Any random text of 32+ characters. Make one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Changing it logs every admin out.
JWT_SECRET=

# Only for `npm run dev:memory` (temporary local database). Not used with Atlas;
# real admins are created with `npm run create-admin`.
DEV_ADMIN_EMAIL=admin@aanchol.test
DEV_ADMIN_PASSWORD=dev-only-password

# Photo uploads (cloudinary.com → Dashboard → API Keys). Optional: without these,
# the admin works but can't upload photos.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
